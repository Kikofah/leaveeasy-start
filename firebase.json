{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".claude/**",
      "**/node_modules/**",
      "seed.html",
      "js/seed.js",
      "**/*.env",
      "**/*secret*"
    ]
  }
}
