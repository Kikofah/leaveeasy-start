rules_version = '2';

// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎเฝ้าข้อมูลของ LeaveEasy
//
// กฎเดียวตอนนี้: ต้องล็อกอินก่อน ถึงจะอ่านหรือเขียนข้อมูลได้
// (ยังไม่แยกสิทธิ์ตาม role — เช่น employee ห้ามเปลี่ยนสถานะ,
//  ห้ามอนุมัติใบลาของตัวเอง ฯลฯ ตาม ACL.md เป็นงานขั้นถัดไป)
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
